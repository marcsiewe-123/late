      "ticketId": "ticket_1",
      "senderId": "user_superadmin",
      "senderName": "Support PointAfrik",
      "senderRole": "support_admin",
      "content": "Bonjour Marc ! C’est une excellente question. Dans la section Employés, vous pouvez attribuer des horaires personnalisés par shift à chaque collaborateur. Le calcul du retard s’adaptera automatiquement.",
      "createdAt": "2026-10-26T05:58:20.334Z"
    },
